6:["$","$L10",null,{"children":[["$","article",null,{"className":"mx-auto max-w-7xl px-6 lg:px-8 mt-24 sm:mt-32 lg:mt-40","children":["$","div",null,{"className":"mx-auto max-w-2xl lg:max-w-none","children":[["$","$L4",null,{"children":["$","header",null,{"className":"mx-auto flex max-w-5xl flex-col text-center","children":[["$","h1",null,{"className":"mt-6 font-display text-5xl font-medium tracking-tight text-balance text-neutral-950 sm:text-6xl","children":"What ER Diagrams Clarify Before Code Exists"}],["$","time",null,{"dateTime":"2026-04-22","className":"order-first text-sm text-neutral-950","children":"April 22, 2026"}],["$","p",null,{"className":"mt-6 text-sm font-semibold text-neutral-950","children":["by ","Dusti Johnson",", ","Developer"]}]]}]}],["$","$L4",null,{"children":["$","div",null,{"className":"*:mx-auto *:max-w-3xl *:first:mt-0! *:last:mb-0! mt-24 sm:mt-32 lg:mt-40","children":[["$","div",null,{"className":"typography","children":["\n","\n",["$","h2",null,{"children":"Entities are not tables yet"}],"\n",["$","p",null,{"children":"When I sketch an ER diagram, I try to avoid jumping straight to table design.\nThe first pass is about the real objects in the problem: users, sessions,\nrecords, plans, mentors, exercises, or whatever the domain actually uses."}],"\n",["$","p",null,{"children":"That distinction matters because implementation details can hide a bad model.\nIf the entities are unclear before code exists, the database schema will usually\ncarry that confusion forward."}],"\n",["$","h2",null,{"children":"Relationships expose product rules"}],"\n",["$","p",null,{"children":"Relationships are where a lot of product behavior lives. One mentor can have\nmany sessions. One workout plan can contain many training blocks. A session\nrecord might belong to one student, one mentor, and one program at the same\ntime."}],"\n",["$","p",null,{"children":"Drawing those relationships forces useful questions:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Can this object exist on its own?"}],"\n",["$","li",null,{"children":"Is this relationship one-to-one, one-to-many, or many-to-many?"}],"\n",["$","li",null,{"children":"What should happen when a related record is deleted?"}],"\n",["$","li",null,{"children":"Which entity owns the lifecycle of the data?"}],"\n"]}],"\n",["$","p",null,{"children":"The answers shape the interface and the code, not just the database."}],"\n"]}],["$","div",null,{"className":"my-10 pl-8 relative before:absolute after:absolute before:bg-neutral-950 after:bg-neutral-950/10 before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px","children":[["$","p",null,{"className":"font-display text-sm font-bold tracking-widest text-neutral-950 uppercase","children":"Top tip"}],["$","div",null,{"className":"mt-4","children":["$","p",null,{"children":"If the diagram needs a paragraph of explanation for every relationship, the\nmodel probably needs simpler names or cleaner boundaries."}]}]]}],["$","div",null,{"className":"typography","children":["\n",["$","h2",null,{"children":"Diagrams make tradeoffs discussable"}],"\n",["$","p",null,{"children":"The value of an ER diagram is not that it becomes permanent documentation. The\nvalue is that it gives people something concrete to argue with before the\nimplementation gets expensive."}],"\n",["$","p",null,{"children":"That has helped me in projects where the hard part was not writing queries. The\nhard part was deciding what the data meant and how future changes should fit\nwithout bending the whole application around a bad assumption."}],"\n","\n"]}]]}]}]]}]}],["$","div",null,{"className":"relative pt-24 sm:pt-32 lg:pt-40 mt-24 sm:mt-32 lg:mt-40","children":[["$","div",null,{"className":"absolute inset-x-0 top-0 -z-10 h-[884px] overflow-hidden rounded-t-4xl bg-linear-to-b from-neutral-50","children":["$","$L11",null,{"className":"absolute inset-0 h-full w-full mask-[linear-gradient(to_bottom_left,white_40%,transparent_50%)] fill-neutral-100 stroke-neutral-950/5","yOffset":-270}]}],"$L12","$L13"]}],"$L14"]}]
