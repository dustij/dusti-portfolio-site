d:[["$","title","0",{"children":"What ER Diagrams Clarify Before Code Exists - Dusti Johnson"}],["$","meta","1",{"name":"description","content":"A good ER diagram makes entities, relationships, and ownership visible before those assumptions harden into application code."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?60f8fdf2017983bc","type":"image/x-icon","sizes":"16x16"}],["$","$Lf","3",{}]]
