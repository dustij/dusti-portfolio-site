11:["$","div",null,{"className":"my-10 pl-8 relative before:absolute after:absolute before:bg-neutral-950 after:bg-neutral-950/10 before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px","children":[["$","p",null,{"className":"font-display text-sm font-bold tracking-widest text-neutral-950 uppercase","children":"Top tip"}],["$","div",null,{"className":"mt-4","children":["$","p",null,{"children":"If a router or condition cannot be named as a question, I usually do not\nunderstand the branch well enough yet."}]}]]}]
12:["$","div",null,{"className":"typography","children":["\n",["$","h2",null,{"children":"Keep tool names secondary"}],"\n",["$","p",null,{"children":["Module labels still matter, but they should not be the main abstraction.\n",["$","code",null,{"children":"Get Lead By Email"}]," is better than ",["$","code",null,{"children":"Search Records"}]," because the Salesforce\nmodule is only the implementation detail. ",["$","code",null,{"children":"POST: onLeadSourceReceived"}]," is better\nthan ",["$","code",null,{"children":"HTTP request"}]," because it names the side effect."]}],"\n",["$","p",null,{"children":"This is especially important when a scenario mixes Salesforce, webhooks, HTTP\nrequests, AI-assisted matching, JavaScript validation, and ticket creation. The\ntools are different, but the workflow still needs one readable story."}],"\n",["$","h2",null,{"children":"Small components make failures smaller"}],"\n",["$","p",null,{"children":"The biggest practical benefit of modular automation is troubleshooting. If a\nnew opportunity fails, I want to know whether the problem is the security check,\nlead lookup, lead creation, lead source mapping, or the outbound push. Those\nshould be inspectable as separate pieces."}],"\n",["$","p",null,{"children":["Small scenarios also make testing easier. I can test ",["$","code",null,{"children":"getMappedLeadSource"}],"\nwithout triggering the whole opportunity flow. I can test ",["$","code",null,{"children":"pushLeadSourceToAESync"}],"\nwith a known contact ID, opportunity ID, and lead source. That makes sandbox\ntesting more targeted and production changes less risky."]}],"\n",["$","p",null,{"children":"Deliberate names are not decoration. They are part of the architecture. In Make,\nwhere so much logic lives visually, a good name is often the difference between\na workflow someone can maintain and a workflow someone is afraid to touch."}],"\n","\n"]}]
