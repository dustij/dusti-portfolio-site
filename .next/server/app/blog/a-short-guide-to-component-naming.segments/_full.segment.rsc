d:[["$","title","0",{"children":"A Short Guide to Naming Automation Components - Dusti Johnson"}],["$","meta","1",{"name":"description","content":"Large Make scenarios are easier to maintain when workflow logic is split into named components with clear inputs, outputs, and responsibility."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?60f8fdf2017983bc","type":"image/x-icon","sizes":"16x16"}],["$","$Lf","3",{}]]
